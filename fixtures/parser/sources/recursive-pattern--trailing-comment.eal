language "EAL/3"
environment lab {
  require site == "bench"
}
tool collector {
  version "1"
}
context environment lab, tool collector, max_age 60, kind test {
  evidence first {
    require ok
  }
  evidence second {
    require ok
  }
  claim passed {
    statement "The checks pass under the declared relation."
  }
}
reasoning measured {
  method "structured/1"
  rationale "An explicitly authored relation."
}
pattern each(c: claim, r: reasoning, es: evidence[]) decreases es {
  when es {
    argument item = [evidence head(es)] via r => c
    apply rest = each(c=c, r=r, es=tail(es))
  }
}
apply checks = each(c=passed, r=measured, es=[first, second]) // final hidden comment