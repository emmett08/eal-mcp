/* Unicode block β 😀
second line */
language "EAL/3"
environment lab {
  require site == "bench"
}
tool collector {
  version "1"
}
context environment lab, tool collector, max_age 60, kind test {
  evidence first {
    require ok
  }
  evidence second {
    require ok
  }
  claim passed {
    statement "The checks pass under the declared relation."
  }
}
reasoning measured {
  method "structured/1"
  rationale "An explicitly authored relation."
}
pattern together(c: claim, r: reasoning, es: evidence[]) = [evidence es] via r => c
apply checks = together(c=passed, r=measured, es=[second, first])
