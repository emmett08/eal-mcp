language /* 😀 */ "EAL/3"
environment expr {
  require not failed and count(samples) == 2 or ready
  require +a - -b * c / 2 % 3 != (field("sensor-name") + 1.5e-2)
  require a <= 2
  require a >= 2
  require a < 2
  require a > 2
  require length() == 0
  require quantity(distance, "m") == quantity(1, "m")
  require {"nested": [{}, [], "\u03b1", false, null]} == null
}
