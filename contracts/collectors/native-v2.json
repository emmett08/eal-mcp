{
  "schema": "eal.collector-catalogue/1",
  "acquisition_contract": "eal.acquisition/1",
  "collectors": [
    {
      "id": "kubernetes",
      "version": "2",
      "purpose": "Read a named Kubernetes resource in every operator-declared inventory context. Resource presence remains separate from health and inventory completeness. Observations retain acquisition intervals and conservative oldest-sample age. Fleet readings are sequential. Generation is optional and absence is preserved.",
      "parameters": [
        "inventory",
        "resource",
        "kind",
        "namespace",
        "name",
        "scope"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource",
          "namespace",
          "name",
          "scope"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9_.][A-Za-z0-9_.-]*$"
          },
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9_.][A-Za-z0-9_.-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9_.][A-Za-z0-9_.-]*$"
          },
          "scope": {
            "type": "string",
            "enum": [
              "namespaced"
            ]
          }
        }
      },
      "result_schema": {
        "type": "object",
        "required": [
          "cluster_count",
          "all_present",
          "clusters",
          "resource_scope"
        ],
        "properties": {
          "cluster_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          },
          "all_present": {
            "type": "boolean"
          },
          "clusters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "cluster",
                "context",
                "present",
                "acquisition_interval"
              ],
              "properties": {
                "cluster": {
                  "type": "string"
                },
                "context": {
                  "type": "string"
                },
                "present": {
                  "type": "boolean"
                },
                "acquisition_interval": {
                  "type": "object",
                  "required": [
                    "started_at",
                    "completed_at",
                    "observed_at",
                    "wall_clock_regressed"
                  ],
                  "properties": {
                    "started_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "completed_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "observed_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "wall_clock_regressed": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "resource": {
                  "type": "object",
                  "required": [
                    "apiVersion",
                    "kind",
                    "metadata"
                  ],
                  "properties": {
                    "apiVersion": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "metadata": {
                      "type": "object",
                      "required": [
                        "name",
                        "uid",
                        "resourceVersion",
                        "namespace"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "uid": {
                          "type": "string",
                          "minLength": 1
                        },
                        "resourceVersion": {
                          "type": "string",
                          "minLength": 1
                        },
                        "generation": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9223372036854775807
                        },
                        "namespace": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    },
                    "status": {}
                  }
                }
              },
              "if": {
                "properties": {
                  "present": {
                    "const": true
                  }
                }
              },
              "then": {
                "required": [
                  "resource"
                ]
              }
            }
          },
          "resource_scope": {
            "type": "string",
            "enum": [
              "namespaced"
            ]
          }
        }
      },
      "command": {
        "argv": [
          "eal-collector",
          "kubernetes",
          "--contract-version",
          "2",
          "--executable",
          "{operator.executable}",
          "--supervisor",
          "{operator.supervisor}",
          "--inventory",
          "{inventory}",
          "--resource",
          "{resource}",
          "--kind",
          "{kind}",
          "--namespace",
          "{namespace}",
          "--name",
          "{name}",
          "--inherit-env",
          "PATH",
          "--inherit-env",
          "HOME",
          "--inherit-env",
          "KUBECONFIG",
          "--timeout-seconds",
          "60",
          "--max-bytes",
          "1048576",
          "--scope",
          "namespaced"
        ],
        "inherit_env": [
          "PATH",
          "HOME",
          "KUBECONFIG"
        ],
        "timeout_seconds": 65,
        "max_output_bytes": 4194304,
        "parallel_safe": false
      },
      "acquisition_predicate": "cluster_count >= 1",
      "constraints": []
    },
