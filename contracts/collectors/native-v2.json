    {
      "id": "github",
      "version": "2",
      "purpose": "Read an exact GitHub commit and tree through the operator-selected gh executable. Deployment correspondence requires separate evidence. Observations retain acquisition intervals and conservative oldest-sample age. Fleet readings are sequential.",
      "parameters": [
        "repository",
        "commit"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "commit"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 3,
            "maxLength": 507,
            "pattern": "^(?!\\.{1,2}/)(?![^/]+/\\.{1,2}$)[A-Za-z0-9_.][A-Za-z0-9_.-]{0,252}/[A-Za-z0-9_.][A-Za-z0-9_.-]{0,252}$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{40}$"
          }
        }
      },
      "result_schema": {
        "type": "object",
        "required": [
          "found",
          "commit",
          "tree"
        ],
        "properties": {
          "found": {
            "type": "boolean"
          },
          "commit": {
            "type": "string"
          },
          "tree": {
            "type": "string"
          }
        }
      },
      "command": {
        "argv": [
          "eal-collector",
          "github",
          "--contract-version",
          "2",
          "--executable",
          "{operator.executable}",
          "--supervisor",
          "{operator.supervisor}",
          "--repository",
          "{repository}",
          "--commit",
          "{commit}",
          "--inherit-env",
          "PATH",
          "--inherit-env",
          "HOME",
          "--inherit-env",
          "GH_TOKEN",
          "--inherit-env",
          "GH_HOST",
          "--timeout-seconds",
          "60",
          "--max-bytes",
          "1048576"
        ],
        "inherit_env": [
          "PATH",
          "HOME",
          "GH_TOKEN",
          "GH_HOST"
        ],
        "timeout_seconds": 65,
        "max_output_bytes": 4194304,
        "parallel_safe": false
      },
      "acquisition_predicate": "found == true",
      "constraints": []
    },
    {
      "id": "tempo",
      "version": "2",
      "purpose": "Search Tempo per inventory cluster for a bounded rollout kind and name. Empty searches retain unavailable negative inference. Authentication requires explicit operator options. Observations retain acquisition intervals and conservative oldest-sample age. Fleet readings are sequential.",
      "parameters": [
        "inventory",
        "url",
        "kind",
        "name",
        "cluster_attribute",
        "start_unix",
        "end_unix"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start_unix",
          "end_unix"
        ],
        "properties": {
          "start_unix": {
            "type": "integer",
            "minimum": 1
          },
          "end_unix": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "result_schema": {
        "type": "object",
        "required": [
          "cluster_count",
          "all_matched",
          "clusters"
        ],
        "properties": {
          "cluster_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          },
          "all_matched": {
            "type": "boolean"
          },
          "clusters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "cluster",
                "matched",
                "acquisition_interval"
              ],
              "properties": {
                "cluster": {
                  "type": "string"
                },
                "matched": {
                  "type": "boolean"
                },
                "acquisition_interval": {
                  "type": "object",
                  "required": [
                    "started_at",
                    "completed_at",
                    "observed_at",
                    "wall_clock_regressed"
                  ],
                  "properties": {
                    "started_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "completed_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "observed_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "wall_clock_regressed": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "command": {
        "argv": [
          "eal-collector",
          "tempo",
          "--contract-version",
          "2",
          "--inventory",
          "{inventory}",
          "--url",
          "{url}",
          "--kind",
          "{kind}",
          "--name",
          "{name}",
          "--cluster-attribute",
          "{cluster_attribute}",
          "--timeout-seconds",
          "60",
          "--max-bytes",
          "1048576"
        ],
        "inherit_env": [
          "PATH",
          "TEMPO_TOKEN",
          "TEMPO_TENANT"
        ],
        "timeout_seconds": 65,
        "max_output_bytes": 4194304,
        "parallel_safe": false
      },
      "acquisition_predicate": "cluster_count >= 1",
      "constraints": [
        {
          "kind": "ordered_window",
          "start": "start_unix",
          "end": "end_unix",
          "max_seconds": 86400
        }
      ]
    }
  ]
