            ]
          }
        }
      },
      "command": {
        "argv": [
          "eal-collector",
          "kubernetes",
          "--contract-version",
          "2",
          "--executable",
          "{operator.executable}",
          "--supervisor",
          "{operator.supervisor}",
          "--inventory",
          "{inventory}",
          "--resource",
          "{resource}",
          "--kind",
          "{kind}",
          "--name",
          "{name}",
          "--inherit-env",
          "PATH",
          "--inherit-env",
          "HOME",
          "--inherit-env",
          "KUBECONFIG",
          "--timeout-seconds",
          "60",
          "--max-bytes",
          "1048576",
