{
  "schema_version": "1.0",
  "status": "planned_field_contract_not_executable_harness",
  "format": "UTF-8 JSONL; one immutable record per event; raw payloads stored separately with hashes.",
  "identity": "All records link to run_manifest and independent scenario_family_id.",
  "missingness": "Use null plus reason for unavailable readings; zero only for observed zero. Never store credentials in logs.",
  "time_units": "UTC ISO8601 timestamps and monotonic nanoseconds; derived latency seconds.",
  "token_units": "Provider-reported logical input/output tokens; cached/reasoning subfields reconciled before summation.",
  "record_fields": {
    "run_manifest": [
      "protocol_version",
      "scenario_family_id",
      "stratum",
      "horizon_turns",
      "repeat",
      "condition",
      "assignment_seed",
      "condition_order",
      "model_provider",
      "model_id",
      "model_snapshot",
      "reasoning_effort",
      "temperature",
      "provider_seed_or_null",
      "tokenizer_version",
      "input_cap_tokens",
      "output_cap_tokens",
      "turn_deadline_seconds",
      "max_cycles",
      "reference_sha",
      "candidate_sha",
      "binary_hash",
      "host_policy_hash",
      "tool_schema_hash",
      "method_registry_fingerprint",
      "scenario_hash",
      "gold_hash_not_model_visible",
      "event_schedule_hash",
      "runtime_platform",
      "provider_time_block",
      "spending_ceiling",
      "started_at_utc"
    ],
    "attempt_event": [
      "event_id",
      "run_id",
      "turn_id",
      "attempt_id",
      "parent_attempt_id_or_null",
      "type_model_tool_cache_eviction",
      "operation",
      "requested_assessment_id",
      "entry_id",
      "claim_id",
      "source_digest",
      "context_fingerprint",
      "method_registry_fingerprint",
      "original_assessed_at",
      "packet_max_bytes",
      "statement_max_bytes",
      "packet_actual_bytes",
      "summary_complete",
      "omitted",
      "request_hash",
      "response_hash",
      "full_request_path",
      "full_response_path",
      "visible_history_hash",
      "visible_reference_ids",
      "evicted_exchange_ids",
      "logical_lookup_id",
      "cache_hit",
      "start_utc",
      "monotonic_start_ns",
      "monotonic_end_ns",
      "time_to_first_token_ms_or_null",
      "status_success_failure_timeout_cancelled",
      "error_class_or_null",
      "usage_raw",
      "input_tokens_or_null",
      "output_tokens_or_null",
      "cached_input_tokens_or_null",
      "reasoning_tokens_or_null",
      "usage_normalisation_version",
      "total_tokens_or_null",
      "retry_number",
      "cost_quote_version"
    ],
    "gold_atom": [
      "scenario_family_id",
      "item_id",
      "item_type",
      "meaning",
      "target",
      "required_status",
      "applicability_interval",
      "source_context_method_revision",
      "common_anchor_turn",
      "eligible_probe_ids",
      "criticality",
      "availability_by_budget",
      "acceptable_qualification",
      "numeric_tolerance_or_null"
    ],
    "score_event": [
      "run_id",
      "probe_id",
      "item_id",
      "assessor_id",
      "blind_answer_id",
      "score_0_or_1",
      "justifying_excerpt",
      "error_type",
      "critical_loss",
      "original_score",
      "adjudicated_score",
      "adjudicator_id",
      "rubric_version"
    ],
    "scenario_summary": [
      "scenario_family_id",
      "condition",
      "number_of_planned_repeats",
      "actual_attempts",
      "completion_rate",
      "total_tokens_known",
      "unknown_usage_attempts",
      "token_lower_bound",
      "token_upper_bound_or_null",
      "logical_lookups",
      "cache_hits",
      "remote_packet_calls",
      "escalations",
      "reassessments",
      "other_tool_calls",
      "observed_latency_seconds",
      "deadline_penalised_latency_seconds",
      "correctness",
      "objection_retention",
      "qualification_retention",
      "critical_loss_any",
      "first_exposure_acquisition_score",
      "direct_probe_scores_separate"
    ]
  }
}
